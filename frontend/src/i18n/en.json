      "tutorial": {
        "title": "How to set up and use your polar scope",
        "intro": "A practical walkthrough for a SkyWatcher polar scope on a Celestron Advanced VX — from one-time setup to using it under a dark sky.",
        "s1": {
          "title": "What polar alignment does",
          "body": "Your mount's RA axis must point at the celestial pole so a single motor can track the sky. The polar scope lets you sight the pole star and place it precisely.",
          "tips": [
            "The pole is near — but not exactly at — the pole star.",
            "Good alignment = long, round-star exposures and reliable go-to."
          ]
        },
        "s2": {
          "title": "One-time: collimate the polar scope to the RA axis",
          "body": "Center a distant object on the reticle, rotate the RA axis 180°, and adjust the three grub screws to remove half the drift. Repeat until the object stays put as you rotate.",
          "tips": [
            "Do this once in daylight on a far landmark (or on Polaris at night).",
            "Adjust the reticle grub screws, never the mount's alt/az bolts.",
            "Tiny turns — the screws are sensitive."
          ]
        },
        "s3": {
          "title": "Set up the mount (Advanced VX)",
          "body": "Level the tripod, set the latitude scale to your latitude, and aim the mount at TRUE north (or south), not magnetic north.",
          "tips": [
            "Use a bubble level; an unlevel tripod throws off the latitude setting.",
            "Correct for magnetic declination between compass north and true north.",
            "Pre-set the latitude bolt near your site latitude before you start."
          ]
        },
        "s4": {
          "title": "See the reticle at night",
          "body": "At night you see stars but not the engraved reticle. Illuminate it dimly: shine a RED light obliquely into the front (objective) end, or use the mount's illuminator if fitted.",
          "tips": [
            "Red only — white light ruins your dark adaption.",
            "A red phone screen held near the objective works in a pinch.",
            "Keep it dim; too bright washes out faint Polaris."
          ]
        },
        "s5": {
          "title": "Place the pole star",
          "body": "Rotate the RA axis until the reticle's pole-star marker is at the clock position shown above, then use the mount's ALT and AZ bolts (not RA) to move the star into the marker.",
          "tips": [
            "Match the on-screen orientation (inverting/erect) to your scope.",
            "Move with the slow alt/az bolts; leave RA where you set it.",
            "Center the star in the small circle, not on the true-pole cross."
          ]
        },
        "s6": {
          "title": "Verify and refine",
          "body": "Cross-check with the Advanced VX hand controller's All-Star Polar Align, or do a quick drift check on a star near the meridian and tweak the alt/az bolts.",
          "tips": [
            "All-Star uses any bright star — handy when Polaris is hidden.",
            "Re-check after the mount settles or if you bump the tripod."
          ]
        }
      }
    },
