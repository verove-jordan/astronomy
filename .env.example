# Copy to .env and adjust. Real .env is git-ignored; never commit secrets.

# --- Postgres (the only containerized stateful service) ---
POSTGRES_USER=astro
POSTGRES_PASSWORD=astro
POSTGRES_DB=astrostack
POSTGRES_PORT=5432

# Connection string used by the host-run Go engine (talks to the compose Postgres).
DATABASE_URL=postgres://astro:astro@localhost:5432/astrostack?sslmode=disable

# --- HTTP API (host) ---
API_ADDR=:8080
LOG_LEVEL=info

# --- Data directories (host paths the engine reads/writes) ---
# Root that the web UI is allowed to browse for capture folders.
ASTRO_DATA_DIR=./data
# Scratch space for intermediate FITS / sequences during processing.
ASTRO_WORK_DIR=./work
# Where final stacks and reports are written.
ASTRO_OUTPUT_DIR=./output
# Persistent calibration-master library (darks/flats/bias reused across sessions).
ASTRO_LIBRARY_DIR=./library
# Longest edge (px) of the in-browser frame-preview buffer the API decodes; smaller = less memory.
PREVIEW_MAX_EDGE=1500

# --- Host tools the engine shells out to ---
SIRIL_BIN=/Applications/Siril.app/Contents/MacOS/siril-cli
GIMP_BIN=/Applications/GIMP.app/Contents/MacOS/gimp-console-2.10
# GIMP Script-Fu server the engine drives (shared with the GIMP MCP).
GIMP_HOST=127.0.0.1
GIMP_PORT=10008
FFMPEG_BIN=ffmpeg

# --- Optional astro-AI tools (open-source; invoked, never bundled) ---
# GraXpert: AI background-gradient extraction (replaces Siril subsky when present).
# StarNet++ v2: star removal for star-reduced finishing. Both are optional — when the
# binary is missing the pipeline logs a warning and falls back. Disable per-run with `--no-ai`.
# pip/pipx installs put `graxpert` on PATH (no GraXpert.app), so resolve by name; override with an
# absolute path if you use the .app build. exec.LookPath accepts a bare name or an absolute path.
GRAXPERT_BIN=graxpert
STARNET_BIN=starnet++

# --- Optional local-AI-agent finish supervisor (opt-in) ---
# When a run opts in (the web UI's "Run with local AI agent" checkbox, or `astrostack process
# --supervise`), the engine drives a host-run, OpenAI-compatible model server to re-render only the
# fast GIMP composite a few times — each judged by a local vision model — and keeps the best. Off by
# default; an empty/unreachable URL falls back to the normal finish.
#
# Start the server with `just run-ia-model` (mlx-vlm in a local .venv-ia; first run downloads ~26 GB).
# ASTRO_LLM_MODEL is the Hugging Face MLX repo — BOTH the id the engine sends AND what the recipe
# serves. 96 GB M2 Max default: Qwen2.5-VL-32B 6-bit. Alternatives: -8bit (~34 GB, max fidelity),
# -4bit (~18 GB, lightest), or Qwen2.5-VL-72B-Instruct-4bit (~40 GB). LM Studio is a drop-in fallback.
ASTRO_LLM_URL=http://127.0.0.1:1234/v1
ASTRO_LLM_PORT=1234
ASTRO_LLM_MODEL=mlx-community/Qwen2.5-VL-32B-Instruct-6bit
# Image wire-format for the vision request: "openai" ({image_url:{url}}) or "mlxvlm" ({input_image}).
# Default openai; switch to mlxvlm only if mlx-vlm rejects the OpenAI image block.
ASTRO_LLM_IMAGE_FORMAT=openai
# Hugging Face token (free: https://huggingface.co/settings/tokens). STRONGLY recommended — without it
# the first `just run-ia-model` download is throttled hard (~hours for the 26 GB 32B). Resumable: set
# it and re-run to finish at full speed. Loaded via dotenv. Secret — never commit your real .env.
HF_TOKEN=

# --- Resource limits (keep a heavy stack from freezing the host) ---
# Siril defaults to ALL cores and 90% of RAM, which thrashes swap and can near-freeze the machine.
# These cap it via Siril's own setcpu/setmem (injected into every script) plus OS niceness.
ASTRO_MAX_CPUS=10            # cap Siril processing threads (setcpu); 0 = Siril default (all cores)
ASTRO_SIRIL_MEM_RATIO=0.5    # fraction of available RAM Siril may use (setmem); 0 = Siril default (0.9)
ASTRO_SIRIL_NICE=10          # lower siril-cli OS priority so the UI stays responsive; 0 = unchanged
ASTRO_MAX_WORKERS=0          # max concurrent jobs in the API worker pool; 0 = runtime.NumCPU()/2

# --- Plate-solving + SPCC color calibration ---
# Rig optics (the FITS rarely carries FOCALLEN); used to plate-solve before SPCC.
ASTRO_FOCAL_MM=740            # Takahashi FC-100 DF native focal length (mm)
ASTRO_PIXEL_UM=3.8            # ASI1600MM Pro pixel size (µm)
# SPCC sensor + filter + white-reference names. These MUST match Siril's spcc-database entries
# EXACTLY (case + spacing) or SPCC aborts and the sky goes brown. The ASI1600MM Pro's sensor entry is
# "ZWO ASI1600MM" (NOT "...Pro" — that name does not exist in the DB). A mono sensor also needs the
# per-channel filter names; these are ZWO's CMOS-optimized LRGB set. (See the DB under
# "~/Library/Application Support/org.siril.Siril/siril-spcc-database/".)
ASTRO_SPCC_SENSOR=ZWO ASI1600MM
ASTRO_SPCC_RFILTER=ZWO Optimized for CMOS Red
ASTRO_SPCC_GFILTER=ZWO Optimized for CMOS Green
ASTRO_SPCC_BFILTER=ZWO Optimized for CMOS Blue
ASTRO_SPCC_WHITEREF=Average Spiral Galaxy
# SPCC OSC sensor for the milkyway/nightscape path (the one-shot camera, e.g. a DSLR). Blank disables
# SPCC for nightscapes — a phone sensor is rarely in Siril's SPCC DB — using the neutralization path.
ASTRO_NIGHTSCAPE_OSC_SENSOR=
ASTRO_PLATESOLVE_CATALOG=     # blank = Siril auto (online Gaia DR3 via Vizier); e.g. nomad/localgaia
# Siril's bundled object catalogues (name→coords); blank = derived from SIRIL_BIN's app bundle.
ASTRO_SIRIL_CATALOG_DIR=

# --- Tonight's targets (deep-sky visibility planner) ---
# Observing site: drives every altitude/azimuth and the twilight (dark-window) calculation. Defaults
# to Paris so the page works out of the box — set yours, or change it live in the UI (map / address /
# geolocation; the choice is remembered in the browser). Timezone formats the local dusk/dawn/transit.
ASTRO_LAT=48.8566            # observer latitude (degrees, +N)
ASTRO_LON=2.3522             # observer longitude (degrees, +E)
ASTRO_ELEVATION_M=0          # observer elevation (metres)
ASTRO_TIMEZONE=Europe/Paris  # IANA timezone for local-time display
# Aperture + sensor dimensions complete the rig (ASTRO_FOCAL_MM/ASTRO_PIXEL_UM above are reused) so the
# planner can score framing (object size vs field of view) and detectability (aperture light grasp).
ASTRO_APERTURE_MM=100        # Takahashi FC-100 DF aperture (mm)
ASTRO_SENSOR_W=4656          # sensor width (px) — ASI1600MM Pro
ASTRO_SENSOR_H=3520          # sensor height (px) — ASI1600MM Pro
# Visual-observing kit for the planner's eyepiece mode: "focalMM:apparentFOVdeg[:label]" items, comma-
# separated (overridable per-session in the UI; blank disables the per-target eyepiece recommendation).
ASTRO_EYEPIECES=30:68:30mm,18:65:18mm,10:60:10mm,6:60:6mm
ASTRO_BARLOW=1               # Barlow/amplifier factor applied to focal length (image scale, FOV, power); 1 = none

# --- Dark-sky finder (Tonight → Dark sky tab) ---
# Grids a map area for low light pollution, then scores the top candidates' horizon openness from terrain
# sampled via the keyless Open-Meteo Elevation API. Works out of the box; tune the scan/terrain ring below.
ASTRO_ELEVATION_API_URL=             # blank = built-in default (Open-Meteo elevation)
ASTRO_ELEVATION_CACHE_TTL=720        # hours an elevation sample is cached (terrain is static)
ASTRO_DARKSKY_MAX_CELLS=4000         # cap on grid cells scanned per area search
ASTRO_HORIZON_CANDIDATES=10          # how many top dark candidates get horizon scoring
ASTRO_HORIZON_AZIMUTHS=12            # azimuth samples around the horizon
ASTRO_HORIZON_RADII_M=1000,2500      # sample distances (m) along each azimuth
ASTRO_HORIZON_OPEN_THRESHOLD_DEG=3   # an azimuth is "open" below this horizon elevation angle

# --- Astronomy weather (Tonight overlays + forecast panel) ---
# Free + keyless by default: Open-Meteo (forecast + air quality), 7Timer! ASTRO (seeing/transparency) and
# NOAA SWPC (Kp/aurora). Weather is a forecast timeline shown as map layers + a panel — it does NOT change
# visibility scores. The grid is one Open-Meteo multi-point call over ±radius around the site.
ASTRO_WEATHER_OPENMETEO_URL=         # blank = built-in default (Open-Meteo forecast)
ASTRO_WEATHER_AIRQUALITY_URL=        # blank = built-in default (Open-Meteo air quality)
ASTRO_WEATHER_SEVENTIMER_URL=        # blank = built-in default (7Timer! ASTRO)
ASTRO_WEATHER_SWPC_URL=              # blank = built-in default (NOAA SWPC planetary Kp)
ASTRO_WEATHER_GRID_RADIUS_DEG=4      # half-size (deg) of the forecast grid around the site
ASTRO_WEATHER_GRID_SIZE=16           # grid is GRID_SIZE × GRID_SIZE cells
ASTRO_WEATHER_CACHE_TTL_MIN=30       # minutes a forecast grid is cached per bbox/site+hour
ASTRO_WEATHER_METEOBLUE_KEY=         # optional (server-side only); for a future paid satellite-map layer

# --- Cross-session reuse (grow integration + deepen calibration) ---
# Every run is recorded in the frame catalog. When enabled, a new run folds in prior light frames of
# the same target (matched by RA/Dec cone, else normalized name) to grow total integration, and pools
# every matching raw bias/dark across sessions into deeper, lower-noise masters. Flats stay
# session-specific. The UI auto-discovers reusable data and lets you deselect nights before running.
ASTRO_REUSE_ENABLED=true             # false disables reuse (runs single-session, still records catalog)
ASTRO_REUSE_CONE_DEG=0.5             # coordinate-match radius for same-target light frames (degrees)
ASTRO_REUSE_DARK_RECENCY_DAYS=0      # ignore darks older than N days (0 = no age limit)
ASTRO_REUSE_TEMP_TOL_C=5.0           # dark/light temperature match tolerance (°C)

# --- Live stacking ---
# A live session watches a source (a local directory or an S3 bucket) for newly-arriving subs and
# incrementally re-stacks them. The re-stack uses Siril's full winsorized rejection over all subs each
# batch; calibration is cached per-frame and the heavy finish runs once on Stop. The knobs below trade
# live-preview freshness for CPU on long sessions.
ASTRO_LIVESTACK_POLL_SEC=3           # how often the source is polled for new files
ASTRO_LIVESTACK_STABILITY_SEC=2      # a local file is ingested only after its size is stable this long
ASTRO_LIVESTACK_RESTACK_EVERY=1      # re-stack after at least this many new lights have arrived
ASTRO_LIVESTACK_MIN_INTERVAL_SEC=0   # and at least this many seconds since the last re-stack (0 = none)

# --- S3 source for live stacking (credentials read here ONLY, never the UI) ---
# Bucket + prefix are chosen per session in the UI. Endpoint blank = AWS S3; set it (host[:port], no
# scheme) for any S3-compatible store (MinIO/Wasabi/Backblaze B2/Cloudflare R2).
ASTRO_S3_ENDPOINT=                   # blank = AWS S3 (s3.amazonaws.com); else e.g. localhost:9000
ASTRO_S3_REGION=us-east-1
ASTRO_S3_ACCESS_KEY_ID=
ASTRO_S3_SECRET_ACCESS_KEY=
ASTRO_S3_USE_SSL=true                # false for a plaintext MinIO/dev endpoint

# --- Light pollution (per-site sky brightness → map overlay + visibility scores) ---
# Works out of the box, KEYLESS: the tile URL defaults to NASA GIBS VIIRS Black Marble, which feeds both
# the map overlay AND (sampled per-site) the sky brightness. Resolution order, soft-failing so a value
# always computes: keyed online API (if set) → offline atlas (if installed) → GIBS tiles (default) →
# ASTRO_SKY_DEFAULT_SQM. The API key is read HERE ONLY (never the UI, never logged); the browser reaches
# the overlay tiles through the server proxy. URLs are templates: {lat}{lon}{key} for the point API,
# {z}{x}{y}{key} for the tiles. Optional calibrated provider (lightpollutionmap.info-style):
#   ASTRO_LIGHTPOLLUTION_API_URL=https://www.lightpollutionmap.info/QueryRaster/?ql=viirs_2023&qt=point&qd={lon},{lat}&key={key}
ASTRO_LIGHTPOLLUTION_API_URL=        # blank disables the optional keyed online step (GIBS still works)
ASTRO_LIGHTPOLLUTION_API_KEY=        # free key from your calibrated provider; server-side only
ASTRO_LIGHTPOLLUTION_TILE_URL=       # blank = use the built-in keyless GIBS default; set to override
ASTRO_LIGHTPOLLUTION_ATLAS=          # offline grid path; blank = <ASTRO_DATA_DIR>/lightpollution/atlas.bin
ASTRO_LIGHTPOLLUTION_CACHE_TTL=720   # hours a per-site value / tile is reused (VIIRS refreshes ~monthly)
ASTRO_SKY_DEFAULT_SQM=21.3           # last-resort sky brightness, mag/arcsec² (higher = darker; 21.3 ≈ Bortle 4)
# Offline-atlas refresh source for `just update-light-pollution-data` (configure ONE):
ASTRO_LIGHTPOLLUTION_ATLAS_URL=      # a ready-made atlas.bin (EPSG:4326 row-major float32)
ASTRO_LIGHTPOLLUTION_ATLAS_JSON_URL= # its sidecar (rows/cols/bounds/unit), paired with the above
ASTRO_LIGHTPOLLUTION_ATLAS_TIFF_URL= # OR a VIIRS/World-Atlas GeoTIFF to convert locally (needs gdal + jq)
ASTRO_LIGHTPOLLUTION_ATLAS_UNIT=sqm  # how to read atlas cell values: sqm | bortle | mcd | radiance

# --- Adminer (compose profile "tools") ---
ADMINER_PORT=8081

# --- Frontend dev server (host vite) ---
WEB_PORT=5173
# Base URL the frontend uses to reach the API.
VITE_API_BASE=http://localhost:8080

# --- Production frontend image (compose profile "web") ---
WEB_PORT_PROD=8082
