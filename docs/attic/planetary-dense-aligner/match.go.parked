package planetary

import (
	"math"

	"github.com/verove-jordan/astronomy/internal/comet"
	"github.com/verove-jordan/astronomy/internal/fits"
)

// Local matcher primitives. comet's ZNCC is unexported, so planetary keeps its own copy for the per-node
// alignment-point search and the global-drift quality peak. Both operate on ALREADY-blurred single-plane
// images (blur=0 here) so the hot node loop does no repeated blurring.

// Bandpass radii for the AP matching plane: a difference of box blurs (fine − coarse) that keeps
// crater/edge detail while cancelling the slow limb/terminator illumination gradient a raw ZNCC would
// lock onto.
const (
	bandLo = 1
	bandHi = 8
)

// bandpass returns hp = boxBlur(p,lo) − boxBlur(p,hi) of an image's first plane — the illumination-robust
// matching plane for the alignment-point correlation (and the node contrast gate).
func bandpass(im *fits.Image, lo, hi int) *fits.Image {
	p := im.Pix[0]
	loB := comet.BoxBlur(p, im.W, im.H, lo)
	hiB := comet.BoxBlur(p, im.W, im.H, hi)
	out := make([]float32, len(p))
	for i := range out {
		out[i] = loB[i] - hiB[i]
	}
	return &fits.Image{W: im.W, H: im.H, C: 1, Pix: [][]float32{out}}
}

// znccAt is the zero-mean normalized cross-correlation in [-1,1] between ref (at center) and tgt sampled
// at center shifted by (sx,sy) (bilinear, zero-filled outside) over a square window of half-size radius.
// Mirrors comet.zncc so the planetary node search matches the global aligner's correlation surface.
func znccAt(ref, tgt *fits.Image, center comet.Point, radius int, sx, sy float64) float64 {
	w, h := ref.W, ref.H
	rsrc, tsrc := ref.Pix[0], tgt.Pix[0]
	cx, cy := int(math.Round(center.X)), int(math.Round(center.Y))
	var n, sr, st, srr, stt, srt float64
	for y := cy - radius; y <= cy+radius; y++ {
		if y < 0 || y >= h {
			continue
		}
		for x := cx - radius; x <= cx+radius; x++ {
			if x < 0 || x >= w {
				continue
			}
			rv := float64(rsrc[y*w+x])
			tv := biSampleZero(tsrc, w, h, float64(x)-sx, float64(y)-sy)
			n++
			sr += rv
			st += tv
			srr += rv * rv
			stt += tv * tv
			srt += rv * tv
		}
	}
	if n == 0 {
		return -2
	}
	den := (n*srr - sr*sr) * (n*stt - st*st)
	if den <= 0 {
		return -2
	}
	return (n*srt - sr*st) / math.Sqrt(den)
}

// biSampleZero bilinearly samples a plane at (sx,sy); out-of-bounds neighbours contribute zero.
func biSampleZero(src []float32, w, h int, sx, sy float64) float64 {
	x0 := int(math.Floor(sx))
	y0 := int(math.Floor(sy))
	fx := sx - float64(x0)
	fy := sy - float64(y0)
	at := func(x, y int) float64 {
		if x < 0 || y < 0 || x >= w || y >= h {
			return 0
		}
		return float64(src[y*w+x])
	}
	top := at(x0, y0)*(1-fx) + at(x0+1, y0)*fx
	bot := at(x0, y0+1)*(1-fx) + at(x0+1, y0+1)*fx
	return top*(1-fy) + bot*fy
}
