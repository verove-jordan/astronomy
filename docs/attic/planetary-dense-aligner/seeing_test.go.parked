package planetary

import (
	"math"
	"math/rand"
	"testing"

	"github.com/stretchr/testify/assert"
)

// TestSeeingRMS_MonotonicInAmplitude: the detected residual rms rises with the warp amplitude — the
// detector actually measures the seeing, not just noise.
func TestSeeingRMS_MonotonicInAmplitude(t *testing.T) {
	const W, H = 320, 320
	base := richDisk(W, H, 7)
	rng := rand.New(rand.NewSource(4))
	g, cx, cy, onDisk, apRadius := denseGrid(base, 24)
	measRMS := func(amp float64) float64 {
		target := addNoise(applyDenseField(base, sineField(W, H, amp, 0.3)), rng, 0.005)
		dx, dy := g.uniform(0, 0)
		valid := measureAPField(g, bandpass(base, bandLo, bandHi), bandpass(target, bandLo, bandHi),
			cx, cy, onDisk, apRadius, 0, 0, dx, dy)
		return residualOf(g, dx, dy, valid, 0, 0).rms
	}
	prev := -1.0
	for _, amp := range []float64{0.5, 1, 2, 4} {
		r := measRMS(amp)
		assert.Greater(t, r, prev, "residual rms increases with warp amplitude (amp=%.1f → rms=%.3f)", amp, r)
		prev = r
	}
}

// TestDivShearRMS_Analytic: a pure divergence field u=αx, v=0 has divergence ≈ α (within 5%); an isotropic
// expansion u=αx, v=αy has divergence ≈ 2α and ~zero shear.
func TestDivShearRMS_Analytic(t *testing.T) {
	const W, H, N = 320, 320, 16
	g := apGrid{N: N, W: W, H: H}
	cx, cy := g.centers()
	h := float64(min(W, H)) / float64(N)
	alpha := 0.03

	shearField := makeResidual(N, cx, cy, func(x, y float64) (float64, float64) { return alpha * x, 0 })
	div, _ := divShearRMS(g, shearField, h)
	assert.InDelta(t, alpha, div, 0.05*alpha, "u=αx → divergence ≈ α")

	iso := makeResidual(N, cx, cy, func(x, y float64) (float64, float64) { return alpha * x, alpha * y })
	divI, shearI := divShearRMS(g, iso, h)
	assert.InDelta(t, 2*alpha, divI, 0.05*2*alpha, "isotropic expansion → divergence ≈ 2α")
	assert.InDelta(t, 0.0, shearI, 1e-9, "isotropic expansion has no shear")
}

// makeResidual builds a frameResidual whose node field is sampled from f, all nodes valid.
func makeResidual(n int, cx, cy []float64, f func(x, y float64) (float64, float64)) frameResidual {
	fr := frameResidual{u: make([]float64, n*n), v: make([]float64, n*n), valid: make([]bool, n*n)}
	for k := range cx {
		fr.u[k], fr.v[k] = f(cx[k], cy[k])
		fr.valid[k] = true
	}
	return fr
}

func TestSeeingCull_DropsWorstRespectingCap(t *testing.T) {
	report := func(rms []float64, median float64) *SeeingReport {
		r := &SeeingReport{RMSMedian: median}
		for i, v := range rms {
			r.Trace = append(r.Trace, FrameSeeing{Index: i, RMS: v})
		}
		return r
	}

	// Two frames far above the median (and >1 px) → both culled.
	drop := seeingCull(report([]float64{1, 1, 5, 1, 6, 1, 1, 1}, 1.0), 2.5)
	assert.Equal(t, map[int]bool{2: true, 4: true}, drop, "the 2 worst-of-8 are dropped")

	// Four exceed the threshold but the 25% cap (2 of 8) limits the drop.
	drop = seeingCull(report([]float64{1, 1, 3, 3, 3, 3, 1, 1}, 1.0), 2.5)
	assert.Len(t, drop, 2, "the ≤25% cap holds even when more frames exceed the threshold")

	// Above 2.5×median but below the 1-px absolute floor → never culled.
	assert.Empty(t, seeingCull(report([]float64{0.2, 0.2, 0.8, 0.2}, 0.2), 2.5),
		"sub-1px frames are never culled")

	// Disabled.
	assert.Empty(t, seeingCull(report([]float64{1, 9}, 1.0), 0), "SeeingCull<=0 disables culling")
}

// TestSeeingWeights_DownweightsHighRMS: the soft weight is 1 at the median and falls (bounded ≥0.2) for
// high-rms frames.
func TestSeeingWeights_DownweightsHighRMS(t *testing.T) {
	rep := &SeeingReport{RMSMedian: 1.0, Trace: []FrameSeeing{{RMS: 1.0}, {RMS: 4.0}, {RMS: 100.0}}}
	w := seeingWeights(rep)
	assert.InDelta(t, 1.0/(1.0+0.25), w[0], 1e-9, "median frame: rms/(2·med)=0.5 → 1/(1+0.25)")
	assert.Less(t, w[1], w[0], "a worse frame is down-weighted")
	assert.GreaterOrEqual(t, w[2], 0.2, "the weight is floored at 0.2")
	assert.Equal(t, 0.2, w[2], "a wildly bad frame hits the floor")
	assert.False(t, math.IsNaN(w[0]))
}
